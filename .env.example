# FEATHERLESS_API_KEY: Required for Featherless open-weight cloud models.
# Use Qwen, Llama, or other open models in the cloud.
FEATHERLESS_API_KEY="your_featherless_api_key_here"

# SERPAPI_KEY: Server-side API key for SerpApi web evidence discovery.
# Keep strictly on the server; never expose in client bundles.
SERPAPI_KEY=""

# OLLAMA_BASE_URL: Optional local open-weight model runtime endpoint (Gemma / Llama / Qwen).
OLLAMA_BASE_URL="http://localhost:11434"
OPEN_WEIGHT_MODEL="gemma3:4b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
